<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Reference template. `pack-watch attach` renders and installs the concrete per-pack LaunchAgent. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>dev.brymes.agent-workpacks.{{SLUG}}</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{NODE_BIN}}</string>
    <string>{{SKILL_DIR}}/scripts/pack-watch.mjs</string>
    <string>tick</string>
    <string>--pack</string>
    <string>{{PACK_DIR}}</string>
  </array>
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
